{
  "rules": {
    ".read": false,
    ".write": false,
    "snake": {
      "rooms": {
        ".read": "auth != null",
        "$code": {
          ".validate": "$code.length === 4",
          "meta": {
            ".write": "auth != null && ((!data.exists() && (auth.token.admin === 1 || root.child('arena_hosts/' + auth.uid + '/ok').val() === true)) || data.child('host').val() === auth.uid)",
            ".validate": "!newData.exists() || newData.child('host').val() === auth.uid"
          },
          "state": {
            ".write": "auth != null && root.child('snake/rooms/' + $code + '/meta/host').val() === auth.uid"
          },
          "sync": {
            ".write": "auth != null && root.child('snake/rooms/' + $code + '/meta/host').val() === auth.uid"
          },
          "players": {
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || root.child('snake/rooms/' + $code + '/meta/host').val() === auth.uid)",
              ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 12)"
            }
          },
          "rtc": {
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || root.child('snake/rooms/' + $code + '/meta/host').val() === auth.uid)"
            }
          },
          "inputs": {
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || root.child('snake/rooms/' + $code + '/meta/host').val() === auth.uid)"
            }
          },
          ".write": "auth != null && !newData.exists() && (root.child('snake/rooms/' + $code + '/meta/host').val() === auth.uid || (!data.child('meta').exists() || !data.child('players').exists() || !data.child('players').child(data.child('meta/host').val() + '').exists()))",
          "chat": {
            "$id": {
              ".write": "auth != null && !data.exists() && newData.child('u').val() === auth.uid && root.child('snake/rooms/' + $code + '/players/' + auth.uid).exists()",
              ".validate": "newData.child('m').isString() && newData.child('m').val().length <= 120 && newData.child('m').val().length > 0 && newData.child('n').isString() && newData.child('n').val().length <= 12"
            }
          }
        }
      },
      "ac": {
        ".read": "auth != null && auth.token.admin === 1",
        ".write": "auth != null && auth.token.admin === 1",
        "$room": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('snake/rooms/' + $room + '/meta/host').val() === auth.uid)"
          }
        }
      },
      "index": {
        ".read": "auth != null",
        "$code": {
          ".write": "auth != null && (root.child('snake/rooms/' + $code + '/meta/host').val() === auth.uid || (!newData.exists() && (!root.child('snake/rooms/' + $code).child('meta').exists() || !root.child('snake/rooms/' + $code).child('players').exists() || !root.child('snake/rooms/' + $code).child('players').child(root.child('snake/rooms/' + $code).child('meta/host').val() + '').exists())))",
          ".validate": "!newData.exists() || (newData.child('h').isString() && newData.child('h').val().length <= 12)"
        }
      }
    },
    "sc": {
      "rooms": {
        ".read": "auth != null",
        "$code": {
          ".validate": "$code.length === 4",
          ".write": "auth != null && !newData.exists() && (root.child('sc/rooms/' + $code + '/meta/host').val() === auth.uid || !data.child('meta').exists() || !data.child('players').child(data.child('meta/host').val() + '').exists())",
          "meta": {
            ".write": "auth != null && ((!data.exists() && (auth.token.admin === 1 || root.child('arena_hosts/' + auth.uid + '/ok').val() === true)) || data.child('host').val() === auth.uid)",
            ".validate": "!newData.exists() || newData.child('host').val() === auth.uid"
          },
          "state": {
            ".write": "auth != null && root.child('sc/rooms/' + $code + '/meta/host').val() === auth.uid"
          },
          "players": {
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || root.child('sc/rooms/' + $code + '/meta/host').val() === auth.uid)",
              ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 12)"
            }
          },
          "rtc": {
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || root.child('sc/rooms/' + $code + '/meta/host').val() === auth.uid)"
            }
          },
          "note": {
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || root.child('sc/rooms/' + $code + '/meta/host').val() === auth.uid)"
            }
          },
          "cmds": {
            "$id": {
              ".write": "auth != null && ((!data.exists() && newData.child('u').val() === auth.uid && root.child('sc/rooms/' + $code + '/players/' + auth.uid).exists()) || (root.child('sc/rooms/' + $code + '/meta/host').val() === auth.uid && !newData.exists()))"
            }
          },
          "chat": {
            "$id": {
              ".write": "auth != null && !data.exists() && newData.child('u').val() === auth.uid && root.child('sc/rooms/' + $code + '/players/' + auth.uid).exists()",
              ".validate": "newData.child('m').isString() && newData.child('m').val().length <= 120 && newData.child('m').val().length > 0 && newData.child('n').isString() && newData.child('n').val().length <= 12"
            }
          }
        }
      }
    },
    "nyang": {
      "rooms": {
        ".read": "auth != null",
        "$code": {
          ".validate": "$code.length === 4",
          ".write": "auth != null && !newData.exists() && (root.child('nyang/rooms/' + $code + '/meta/host').val() === auth.uid || !data.child('meta').exists() || !data.child('players').exists() || !data.child('players').child(data.child('meta/host').val() + '').exists())",
          "meta": {
            ".write": "auth != null && ((!data.exists() && (auth.token.admin === 1 || root.child('arena_hosts/' + auth.uid + '/ok').val() === true)) || data.child('host').val() === auth.uid)",
            ".validate": "!newData.exists() || newData.child('host').val() === auth.uid"
          },
          "players": {
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || root.child('nyang/rooms/' + $code + '/meta/host').val() === auth.uid)",
              ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 12)"
            }
          },
          "prog": {
            ".write": "auth != null && !newData.exists() && root.child('nyang/rooms/' + $code + '/meta/host').val() === auth.uid",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid"
            }
          },
          "chat": {
            "$id": {
              ".write": "auth != null && !data.exists() && newData.child('u').val() === auth.uid && root.child('nyang/rooms/' + $code + '/players/' + auth.uid).exists()",
              ".validate": "newData.child('m').isString() && newData.child('m').val().length <= 120 && newData.child('m').val().length > 0 && newData.child('n').isString() && newData.child('n').val().length <= 12"
            }
          }
        }
      },
      "rec": {
        ".read": "auth != null",
        "$pid": {
          ".write": "auth != null && ((newData.exists() && root.child('gp/players/' + $pid).exists()) || auth.token.admin === 1)"
        }
      },
      "index": {
        ".read": "auth != null",
        "$code": {
          ".write": "auth != null && (root.child('nyang/rooms/' + $code + '/meta/host').val() === auth.uid || (!newData.exists() && (!root.child('nyang/rooms/' + $code).child('meta').exists() || !root.child('nyang/rooms/' + $code).child('players').exists() || !root.child('nyang/rooms/' + $code).child('players').child(root.child('nyang/rooms/' + $code).child('meta/host').val() + '').exists())))",
          ".validate": "!newData.exists() || (newData.child('h').isString() && newData.child('h').val().length <= 12)"
        }
      }
    },
    "arena_invites": {
      ".read": "auth != null && auth.token.admin === 1",
      "$token": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.admin === 1 || root.child('arena_hosts/' + auth.uid + '/ok').val() === true)",
        ".validate": "$token.length === 6"
      }
    },
    "arena_hosts": {
      ".read": "auth != null && auth.token.admin === 1",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === 1)",
        ".write": "auth != null && (auth.token.admin === 1 || (auth.uid === $uid && newData.child('ok').val() === true && newData.child('token').isString() && newData.child('token').val().matches(/^[A-Za-z0-9]{6}$/) && (root.child('arena_invites/' + newData.child('token').val()).exists() || root.child('game_passes/' + newData.child('token').val() + '/role').val() === 'host')))"
      }
    },
    "game_passes": {
      ".read": "auth != null && (auth.token.admin === 1 || root.child('arena_hosts/' + auth.uid + '/ok').val() === true)",
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.admin === 1 || root.child('arena_hosts/' + auth.uid + '/ok').val() === true)",
        ".validate": "!newData.exists() || ($code.length === 6 && newData.child('role').isString())"
      }
    },
    "game_devices": {
      ".read": "auth != null && (auth.token.admin === 1 || root.child('arena_hosts/' + auth.uid + '/ok').val() === true)",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === 1 || root.child('arena_hosts/' + auth.uid + '/ok').val() === true)",
        ".write": "auth != null && (auth.token.admin === 1 || root.child('arena_hosts/' + auth.uid + '/ok').val() === true || (auth.uid === $uid && ((newData.child('passCode').isString() && newData.child('passCode').val().matches(/^[A-Za-z0-9]{6}$/) && newData.child('status').val() === 'active' && ((root.child('game_passes/' + newData.child('passCode').val()).exists() && root.child('game_passes/' + newData.child('passCode').val() + '/revoked').val() !== true && (!((root.child('game_passes/' + newData.child('passCode').val() + '/hours').isNumber() && root.child('game_passes/' + newData.child('passCode').val() + '/hours').val() > 0) || root.child('game_passes/' + newData.child('passCode').val() + '/role').val() === 'temp24h') || (newData.child('expiresAt').isNumber() && newData.child('expiresAt').val() > now && newData.child('expiresAt').val() <= now + 90000000))) || root.child('arena_invites/' + newData.child('passCode').val()).exists())) || (data.exists() && newData.child('status').val() === data.child('status').val() && newData.child('role').val() === data.child('role').val() && newData.child('expiresAt').val() === data.child('expiresAt').val()))))",
        ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 16 && newData.child('status').isString())"
      }
    },
    "game_requests": {
      ".read": "auth != null && (auth.token.admin === 1 || root.child('arena_hosts/' + auth.uid + '/ok').val() === true)",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === 1 || root.child('arena_hosts/' + auth.uid + '/ok').val() === true)",
        ".write": "auth != null && (auth.uid === $uid || auth.token.admin === 1 || root.child('arena_hosts/' + auth.uid + '/ok').val() === true)",
        ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 16 && newData.child('status').isString())"
      }
    },
    "arena": {
      "$game": {
        ".validate": "$game.matches(/^[a-z]{2,12}$/)",
        "rooms": {
          ".read": "auth != null",
          "$code": {
            ".validate": "$code.length === 4",
            ".write": "auth != null && !newData.exists() && (root.child('arena/' + $game + '/rooms/' + $code + '/meta/host').val() === auth.uid || !data.child('meta').exists() || !data.child('players').exists() || !data.child('players').child(data.child('meta/host').val() + '').exists())",
            "meta": {
              ".write": "auth != null && ((!data.exists() && (auth.token.admin === 1 || root.child('arena_hosts/' + auth.uid + '/ok').val() === true || (root.child('game_devices/' + auth.uid + '/status').val() === 'active' && (!root.child('game_devices/' + auth.uid + '/expiresAt').exists() || root.child('game_devices/' + auth.uid + '/expiresAt').val() === 0 || root.child('game_devices/' + auth.uid + '/expiresAt').val() > now)))) || data.child('host').val() === auth.uid)",
              ".validate": "!newData.exists() || (newData.child('host').val() === auth.uid && newData.child('max').isNumber() && newData.child('max').val() >= 1 && newData.child('max').val() <= 16)"
            },
            "players": {
              "$uid": {
                ".write": "auth != null && (auth.uid === $uid || root.child('arena/' + $game + '/rooms/' + $code + '/meta/host').val() === auth.uid)",
                ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 12)"
              }
            },
            "rtc": {
              "$uid": {
                ".write": "auth != null && (auth.uid === $uid || root.child('arena/' + $game + '/rooms/' + $code + '/meta/host').val() === auth.uid)"
              }
            },
            "up": {
              "$uid": {
                ".write": "auth != null && (auth.uid === $uid || root.child('arena/' + $game + '/rooms/' + $code + '/meta/host').val() === auth.uid)"
              }
            },
            "upq": {
              "$id": {
                ".write": "auth != null && ((!data.exists() && newData.child('u').val() === auth.uid && root.child('arena/' + $game + '/rooms/' + $code + '/players/' + auth.uid).exists()) || (!newData.exists() && root.child('arena/' + $game + '/rooms/' + $code + '/meta/host').val() === auth.uid))"
              }
            },
            "down": {
              ".write": "auth != null && root.child('arena/' + $game + '/rooms/' + $code + '/meta/host').val() === auth.uid"
            },
            "downq": {
              ".write": "auth != null && root.child('arena/' + $game + '/rooms/' + $code + '/meta/host').val() === auth.uid"
            },
            "shared": {
              ".write": "auth != null && root.child('arena/' + $game + '/rooms/' + $code + '/meta/host').val() === auth.uid"
            },
            "chat": {
              "$id": {
                ".write": "auth != null && !data.exists() && newData.child('u').val() === auth.uid && root.child('arena/' + $game + '/rooms/' + $code + '/players/' + auth.uid).exists()",
                ".validate": "newData.child('m').isString() && newData.child('m').val().length <= 120 && newData.child('m').val().length > 0 && newData.child('n').isString() && newData.child('n').val().length <= 12"
              }
            }
          }
        },
        "index": {
          ".read": "auth != null",
          "$code": {
            ".write": "auth != null && (root.child('arena/' + $game + '/rooms/' + $code + '/meta/host').val() === auth.uid || (!newData.exists() && (!root.child('arena/' + $game + '/rooms/' + $code).child('meta').exists() || !root.child('arena/' + $game + '/rooms/' + $code).child('players').exists() || !root.child('arena/' + $game + '/rooms/' + $code).child('players').child(root.child('arena/' + $game + '/rooms/' + $code).child('meta/host').val() + '').exists())))",
            ".validate": "!newData.exists() || (newData.child('h').isString() && newData.child('h').val().length <= 12)"
          }
        }
      }
    },
    "gp": {
      "players": {
        ".read": "auth != null",
        "$pid": {
          ".write": "auth != null && ((newData.exists() && (!data.exists() || newData.child('n').val() === data.child('n').val())) || auth.token.admin === 1)",
          ".validate": "!newData.exists() || (newData.child('n').isString() && newData.child('n').val().length >= 1 && newData.child('n').val().length <= 12)"
        }
      },
      "names": {
        ".read": "auth != null",
        "$key": {
          ".write": "auth != null && (!data.exists() || auth.token.admin === 1)",
          ".validate": "!newData.exists() || newData.isString()"
        }
      }
    },
    "test": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "logs": {
      ".read": "auth != null && auth.token.admin === 1",
      "$game": {
        "$date": {
          "$sid": {
            ".write": "auth != null && (!data.exists() ? newData.child('info/host').val() === auth.uid : data.child('info/host').val() === auth.uid)",
            "net": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid"
              }
            }
          }
        }
      }
    }
  }
}