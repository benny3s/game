{
  "rules": {
    ".read": false,
    ".write": false,
    "snake": {
      "ac": {
        ".read": "auth != null && auth.token.admin === 1",
        ".write": "auth != null && auth.token.admin === 1",
        "$room": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "nyang": {
      "rec": {
        ".read": "auth != null",
        "$pid": {
          ".write": "auth != null && ((newData.exists() && root.child('gp/players/' + $pid).exists()) || auth.token.admin === 1)"
        }
      }
    },
    "game_devices": {
      ".read": "auth != null && (auth.token.admin === 1)",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === 1)",
        ".write": "auth != null && (auth.token.admin === 1 || (auth.uid === $uid && data.exists() && newData.child('status').val() === data.child('status').val() && newData.child('role').val() === data.child('role').val() && newData.child('expiresAt').val() === data.child('expiresAt').val()))",
        ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 16 && newData.child('status').isString())"
      }
    },
    "game_requests": {
      ".read": "auth != null && (auth.token.admin === 1)",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === 1)",
        ".write": "auth != null && (auth.token.admin === 1 || (auth.uid === $uid && (!newData.exists() || (newData.child('t').val() === now && (!data.exists() || data.child('status').val() !== 'pending' || data.child('t').val() < now - 600000)))))",
        ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 16 && newData.child('status').isString() && newData.child('status').val().length <= 16 && (!newData.child('note').exists() || (newData.child('note').isString() && newData.child('note').val().length <= 60)) && (!newData.child('want').exists() || newData.child('want').val().matches(/^(today|day|week|month|always)$/)) && (!newData.child('ua').exists() || (newData.child('ua').isString() && newData.child('ua').val().length <= 60)) && (!newData.child('game').exists() || (newData.child('game').isString() && newData.child('game').val().length <= 20)))"
      }
    },
    "arena": {
      "$game": {
        ".validate": "$game.matches(/^[a-z]{2,12}$/)",
        "rooms": {
          ".read": "auth != null",
          "$code": {
            ".validate": "$code.length === 4",
            ".write": "auth != null && !newData.exists() && (root.child('arena/' + $game + '/rooms/' + $code + '/meta/host').val() === auth.uid || !data.child('meta').exists() || !data.child('players').exists() || !data.child('players').child(data.child('meta/host').val() + '').exists())",
            "meta": {
              ".write": "auth != null && ((!data.exists() && (auth.token.admin === 1 || (root.child('game_devices/' + auth.uid + '/status').val() === 'active' && (!root.child('game_devices/' + auth.uid + '/expiresAt').exists() || root.child('game_devices/' + auth.uid + '/expiresAt').val() === 0 || root.child('game_devices/' + auth.uid + '/expiresAt').val() > now)))) || data.child('host').val() === auth.uid)",
              ".validate": "!newData.exists() || (newData.child('host').val() === auth.uid && newData.child('max').isNumber() && newData.child('max').val() >= 1 && newData.child('max').val() <= 16 && (!newData.child('title').exists() || (newData.child('title').isString() && newData.child('title').val().length <= 20)) && (!newData.child('lock').exists() || newData.child('lock').val() === true))"
            },
            "players": {
              "$uid": {
                ".write": "auth != null && (root.child('arena/' + $game + '/rooms/' + $code + '/meta/host').val() === auth.uid || (auth.uid === $uid && (root.child('arena/' + $game + '/rooms/' + $code + '/meta/lock').val() !== true || data.exists() || (root.child('arena/' + $game + '/pass/' + $code + '/' + auth.uid).exists() && (root.child('arena/' + $game + '/pass/' + $code + '/' + auth.uid).val() === root.child('arena/' + $game + '/gate/' + $code + '/h').val() || root.child('arena/' + $game + '/pass/' + $code + '/' + auth.uid).val() === root.child('arena/' + $game + '/gate/' + $code + '/k').val())))))",
                ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 12)"
              }
            },
            "rtc": {
              "$uid": {
                ".write": "auth != null && (auth.uid === $uid || root.child('arena/' + $game + '/rooms/' + $code + '/meta/host').val() === auth.uid)"
              }
            },
            "up": {
              "$uid": {
                ".write": "auth != null && (auth.uid === $uid || root.child('arena/' + $game + '/rooms/' + $code + '/meta/host').val() === auth.uid)"
              }
            },
            "upq": {
              "$id": {
                ".write": "auth != null && ((!data.exists() && newData.child('u').val() === auth.uid && root.child('arena/' + $game + '/rooms/' + $code + '/players/' + auth.uid).exists()) || (!newData.exists() && root.child('arena/' + $game + '/rooms/' + $code + '/meta/host').val() === auth.uid))"
              }
            },
            "down": {
              ".write": "auth != null && root.child('arena/' + $game + '/rooms/' + $code + '/meta/host').val() === auth.uid"
            },
            "downq": {
              ".write": "auth != null && root.child('arena/' + $game + '/rooms/' + $code + '/meta/host').val() === auth.uid"
            },
            "shared": {
              ".write": "auth != null && root.child('arena/' + $game + '/rooms/' + $code + '/meta/host').val() === auth.uid"
            },
            "chat": {
              "$id": {
                ".write": "auth != null && !data.exists() && newData.child('u').val() === auth.uid && root.child('arena/' + $game + '/rooms/' + $code + '/players/' + auth.uid).exists()",
                ".validate": "newData.child('m').isString() && newData.child('m').val().length <= 120 && newData.child('m').val().length > 0 && newData.child('n').isString() && newData.child('n').val().length <= 12"
              }
            }
          }
        },
        "index": {
          ".read": "auth != null",
          "$code": {
            ".write": "auth != null && (root.child('arena/' + $game + '/rooms/' + $code + '/meta/host').val() === auth.uid || (!newData.exists() && (!root.child('arena/' + $game + '/rooms/' + $code).child('meta').exists() || !root.child('arena/' + $game + '/rooms/' + $code).child('players').exists() || !root.child('arena/' + $game + '/rooms/' + $code).child('players').child(root.child('arena/' + $game + '/rooms/' + $code).child('meta/host').val() + '').exists())))",
            ".validate": "!newData.exists() || (newData.child('h').isString() && newData.child('h').val().length <= 12 && (!newData.child('ti').exists() || (newData.child('ti').isString() && newData.child('ti').val().length <= 20)) && (!newData.child('lk').exists() || newData.child('lk').val() === 1))"
          }
        },
        "gate": {
          "$code": {
            ".validate": "$code.length === 4 && (!newData.exists() || (newData.child('h').isString() && newData.child('h').val().length <= 64 && newData.child('k').isString() && newData.child('k').val().length <= 32))",
            ".write": "auth != null && (root.child('arena/' + $game + '/rooms/' + $code + '/meta/host').val() === auth.uid || (!newData.exists() && !root.child('arena/' + $game + '/rooms/' + $code + '/meta').exists()))"
          }
        },
        "pass": {
          "$code": {
            ".validate": "$code.length === 4",
            ".write": "auth != null && (root.child('arena/' + $game + '/rooms/' + $code + '/meta/host').val() === auth.uid || (!newData.exists() && !root.child('arena/' + $game + '/rooms/' + $code + '/meta').exists()))",
            "$uid": {
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)",
              ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (newData.isString() && (newData.val() === root.child('arena/' + $game + '/gate/' + $code + '/h').val() || newData.val() === root.child('arena/' + $game + '/gate/' + $code + '/k').val())))"
            }
          }
        }
      }
    },
    "gp": {
      "players": {
        ".read": "auth != null",
        "$pid": {
          ".write": "auth != null && (auth.token.admin === 1 || (newData.exists() && (!data.exists() || newData.child('n').val() === data.child('n').val() || (root.child('gp/pins/' + $pid).exists() && root.child('gp/pinchk/' + $pid + '/' + auth.uid).val() === root.child('gp/pins/' + $pid).val()))))",
          ".validate": "!newData.exists() || (newData.child('n').isString() && newData.child('n').val().length >= 1 && newData.child('n').val().length <= 12 && (!newData.child('h').exists() || auth.token.admin === 1) && (!newData.child('hp').exists() || newData.child('hp').val() === true))"
        }
      },
      "names": {
        ".read": "auth != null",
        "$key": {
          ".write": "auth != null && (!data.exists() || auth.token.admin === 1 || (!newData.exists() && root.child('gp/pins/' + data.val()).exists() && root.child('gp/pinchk/' + data.val() + '/' + auth.uid).val() === root.child('gp/pins/' + data.val()).val()))",
          ".validate": "!newData.exists() || newData.isString()"
        }
      },
      "pins": {
        ".read": "auth != null && auth.token.admin === 1",
        "$pid": {
          ".write": "auth != null && (auth.token.admin === 1 || (!data.exists() && newData.exists()) || (data.exists() && newData.exists() && root.child('gp/pinchk/' + $pid + '/' + auth.uid).val() === data.val()))",
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length === 32)"
        }
      },
      "pinchk": {
        ".read": "auth != null && auth.token.admin === 1",
        "$pid": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val() === newData.parent().parent().parent().child('pins/' + $pid).val()"
          }
        }
      }
    },
    "bank": {
      "_list": {
        ".read": "auth != null && (auth.token.admin === 1 || (root.child('game_devices/' + auth.uid + '/status').val() === 'active' && (!root.child('game_devices/' + auth.uid + '/expiresAt').exists() || root.child('game_devices/' + auth.uid + '/expiresAt').val() === 0 || root.child('game_devices/' + auth.uid + '/expiresAt').val() > now)))",
        "$gid": {
          ".write": "auth != null && (auth.token.admin === 1 || ((root.child('game_devices/' + auth.uid + '/status').val() === 'active' && (!root.child('game_devices/' + auth.uid + '/expiresAt').exists() || root.child('game_devices/' + auth.uid + '/expiresAt').val() === 0 || root.child('game_devices/' + auth.uid + '/expiresAt').val() > now)) && !data.exists() && newData.exists()))",
          ".validate": "!newData.exists() || ($gid.matches(/^g[A-Za-z0-9_-]{3,31}$/) && newData.hasChildren(['name', 't']))",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "$gid": {
        ".validate": "$gid.matches(/^g[A-Za-z0-9_-]{3,31}$/)",
        ".write": "auth != null && !newData.exists() && auth.token.admin === 1",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (auth.token.admin === 1 || ((root.child('game_devices/' + auth.uid + '/status').val() === 'active' && (!root.child('game_devices/' + auth.uid + '/expiresAt').exists() || root.child('game_devices/' + auth.uid + '/expiresAt').val() === 0 || root.child('game_devices/' + auth.uid + '/expiresAt').val() > now)) && !data.exists() && newData.exists()))",
          ".validate": "!newData.exists() || newData.hasChildren(['name', 'chipWon', 'loanUnit'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
          },
          "chipWon": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100000"
          },
          "loanUnit": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10000000"
          },
          "created": {
            ".validate": "newData.isNumber()"
          },
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "kind": {
            ".validate": "newData.isString() && newData.val().length <= 8"
          },
          "expires": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "members": {
          ".read": "auth != null",
          "$pid": {
            ".write": "auth != null && (auth.token.admin === 1 || ((root.child('game_devices/' + auth.uid + '/status').val() === 'active' && (!root.child('game_devices/' + auth.uid + '/expiresAt').exists() || root.child('game_devices/' + auth.uid + '/expiresAt').val() === 0 || root.child('game_devices/' + auth.uid + '/expiresAt').val() > now)) && (newData.exists() || $gid.beginsWith('gbet-'))))",
            ".validate": "!newData.exists() || ($pid.length <= 40 && newData.hasChildren(['name', 'borrowed', 'balance']))",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
            },
            "borrowed": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
            },
            "balance": {
              ".validate": "newData.isNumber() && newData.val() >= -1000000000 && newData.val() <= 1000000000"
            },
            "updated": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "ledger": {
          ".read": "auth != null && (auth.token.admin === 1 || (root.child('game_devices/' + auth.uid + '/status').val() === 'active' && (!root.child('game_devices/' + auth.uid + '/expiresAt').exists() || root.child('game_devices/' + auth.uid + '/expiresAt').val() === 0 || root.child('game_devices/' + auth.uid + '/expiresAt').val() > now)))",
          "$id": {
            ".write": "auth != null && (auth.token.admin === 1 || ((root.child('game_devices/' + auth.uid + '/status').val() === 'active' && (!root.child('game_devices/' + auth.uid + '/expiresAt').exists() || root.child('game_devices/' + auth.uid + '/expiresAt').val() === 0 || root.child('game_devices/' + auth.uid + '/expiresAt').val() > now)) && !data.exists() && newData.exists()))",
            ".validate": "!newData.exists() || ($id.length <= 40 && newData.hasChildren(['t', 'type', 'amount']))",
            "t": {
              ".validate": "newData.isNumber()"
            },
            "type": {
              ".validate": "newData.isString() && newData.val().matches(/^(loan|game|adjust|reset|ai)$/)"
            },
            "pids": {
              ".validate": "newData.isString() && newData.val().length <= 600"
            },
            "pid": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "amount": {
              ".validate": "newData.isNumber() && newData.val() >= -1000000000 && newData.val() <= 1000000000"
            },
            "game": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "round": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "room": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "by": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 12"
            },
            "note": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "$other": {
              ".validate": false
            },
            "u": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            }
          }
        },
        "settlements": {
          ".read": "auth != null && (auth.token.admin === 1 || (root.child('game_devices/' + auth.uid + '/status').val() === 'active' && (!root.child('game_devices/' + auth.uid + '/expiresAt').exists() || root.child('game_devices/' + auth.uid + '/expiresAt').val() === 0 || root.child('game_devices/' + auth.uid + '/expiresAt').val() > now)))",
          "$id": {
            ".write": "auth != null && (auth.token.admin === 1 || ((root.child('game_devices/' + auth.uid + '/status').val() === 'active' && (!root.child('game_devices/' + auth.uid + '/expiresAt').exists() || root.child('game_devices/' + auth.uid + '/expiresAt').val() === 0 || root.child('game_devices/' + auth.uid + '/expiresAt').val() > now)) && !data.exists() && newData.exists()))",
            ".validate": "!newData.exists() || ($id.length <= 40 && newData.hasChildren(['t', 'by']))",
            "t": {
              ".validate": "newData.isNumber()"
            },
            "by": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "chipWon": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100000"
            },
            "residualWon": {
              ".validate": "newData.isNumber() && newData.val() >= -100000000000000 && newData.val() <= 100000000000000"
            },
            "reset": {
              ".validate": "newData.isBoolean()"
            },
            "lines": {
              "$i": {
                ".validate": "$i.length <= 3 && newData.hasChildren(['from', 'to', 'won'])",
                "from": {
                  ".validate": "newData.isString() && newData.val().length <= 40"
                },
                "to": {
                  ".validate": "newData.isString() && newData.val().length <= 40"
                },
                "won": {
                  ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100000000000000"
                },
                "fn": {
                  ".validate": "newData.isString() && newData.val().length <= 12"
                },
                "tn": {
                  ".validate": "newData.isString() && newData.val().length <= 12"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "nets": {
              "$pid": {
                ".validate": "$pid.length <= 40 && newData.isNumber() && newData.val() >= -100000000000000 && newData.val() <= 100000000000000"
              }
            },
            "members": {
              "$pid": {
                ".validate": "$pid.length <= 40 && newData.hasChildren(['name', 'borrowed', 'balance'])",
                "name": {
                  ".validate": "newData.isString() && newData.val().length <= 12"
                },
                "borrowed": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
                },
                "balance": {
                  ".validate": "newData.isNumber() && newData.val() >= -1000000000 && newData.val() <= 1000000000"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "pairs": {
          ".read": "auth != null",
          "$pk": {
            ".write": "auth != null && (auth.token.admin === 1 || ((root.child('game_devices/' + auth.uid + '/status').val() === 'active' && (!root.child('game_devices/' + auth.uid + '/expiresAt').exists() || root.child('game_devices/' + auth.uid + '/expiresAt').val() === 0 || root.child('game_devices/' + auth.uid + '/expiresAt').val() > now)) && newData.exists()))",
            ".validate": "!newData.exists() || ($pk.length >= 3 && $pk.length <= 120 && newData.hasChildren(['a', 'b', 'wa', 'wb', 'ma']))",
            "a": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "b": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "wa": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "wb": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "ma": {
              ".validate": "newData.isNumber() && newData.val() >= -1000000000 && newData.val() <= 1000000000"
            },
            "updated": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        },
        "records": {
          ".read": "auth != null",
          "$pid": {
            ".write": "auth != null && (auth.token.admin === 1 || ((root.child('game_devices/' + auth.uid + '/status').val() === 'active' && (!root.child('game_devices/' + auth.uid + '/expiresAt').exists() || root.child('game_devices/' + auth.uid + '/expiresAt').val() === 0 || root.child('game_devices/' + auth.uid + '/expiresAt').val() > now)) && newData.exists()))",
            ".validate": "!newData.exists() || ($pid.length <= 40 && newData.hasChildren(['name', 'w', 'l']))",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
            },
            "w": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "l": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "updated": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          ".write": "auth != null && auth.token.admin === 1"
        }
      }
    },
    "test": {
      ".read": "auth != null",
      "rank": {
        ".read": "auth != null",
        "$game": {
          ".validate": "$game.matches(/^[a-z0-9]{2,20}$/)",
          "$pid": {
            ".write": "auth != null && newData.exists()",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 12"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "m": {
              "$mode": {
                ".validate": "$mode.matches(/^[fah]$/)",
                "t": {
                  "$tier": {
                    ".validate": "$tier.matches(/^[A-Za-z0-9_-]{1,20}$/)",
                    "$k": {
                      ".validate": "newData.isNumber() && newData.val() > -1000000000 && newData.val() < 1000000000"
                    }
                  }
                },
                "$k": {
                  ".validate": "newData.isNumber() && newData.val() > -1000000000 && newData.val() < 1000000000"
                }
              }
            },
            "base": {
              "$dev": {
                "t": {
                  "$tier": {
                    ".validate": "$tier.matches(/^[A-Za-z0-9_-]{1,20}$/)",
                    "$k": {
                      ".validate": "newData.isNumber() && newData.val() > -1000000000 && newData.val() < 1000000000"
                    }
                  }
                },
                "$k": {
                  ".validate": "newData.isNumber() && newData.val() > -1000000000 && newData.val() < 1000000000"
                }
              }
            },
            "vs": {
              "$opp": {
                "$k": {
                  ".validate": "newData.isNumber() && newData.val() > -1000000000 && newData.val() < 1000000000"
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "rank_days": {
        ".read": "auth != null",
        "$day": {
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$game": {
            "$pid": {
              ".write": "auth != null && newData.exists()",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000"
            }
          }
        }
      },
      "gp": {
        "players": {
          ".read": "auth != null",
          "$pid": {
            ".write": "auth != null && (auth.token.admin === 1 || (newData.exists() && (!data.exists() || newData.child('n').val() === data.child('n').val() || (root.child('test/gp/pins/' + $pid).exists() && root.child('test/gp/pinchk/' + $pid + '/' + auth.uid).val() === root.child('test/gp/pins/' + $pid).val()))))",
            ".validate": "!newData.exists() || (newData.child('n').isString() && newData.child('n').val().length >= 1 && newData.child('n').val().length <= 12 && (!newData.child('h').exists() || auth.token.admin === 1) && (!newData.child('hp').exists() || newData.child('hp').val() === true))"
          }
        },
        "names": {
          ".read": "auth != null",
          "$key": {
            ".write": "auth != null && (!data.exists() || auth.token.admin === 1 || (!newData.exists() && root.child('test/gp/pins/' + data.val()).exists() && root.child('test/gp/pinchk/' + data.val() + '/' + auth.uid).val() === root.child('test/gp/pins/' + data.val()).val()))",
            ".validate": "!newData.exists() || newData.isString()"
          }
        },
        "pins": {
          ".read": "auth != null && auth.token.admin === 1",
          "$pid": {
            ".write": "auth != null && (auth.token.admin === 1 || (!data.exists() && newData.exists()) || (data.exists() && newData.exists() && root.child('test/gp/pinchk/' + $pid + '/' + auth.uid).val() === data.val()))",
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length === 32)"
          }
        },
        "pinchk": {
          ".read": "auth != null && auth.token.admin === 1",
          "$pid": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isString() && newData.val() === newData.parent().parent().parent().child('pins/' + $pid).val()"
            }
          }
        }
      },
      "$other": {
        ".write": "auth != null"
      }
    },
    "logs": {
      ".read": "auth != null && auth.token.admin === 1",
      "$game": {
        "$date": {
          "$sid": {
            ".write": "auth != null && (!data.exists() ? newData.child('info/host').val() === auth.uid : data.child('info/host').val() === auth.uid)",
            "net": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid"
              }
            }
          }
        }
      }
    },
    "rank": {
      ".read": "auth != null",
      "$game": {
        ".validate": "$game.matches(/^[a-z0-9]{2,20}$/)",
        "$pid": {
          ".write": "auth != null && newData.exists() && ((auth.token.admin === 1 || (root.child('game_devices/' + auth.uid + '/status').val() === 'active' && (!root.child('game_devices/' + auth.uid + '/expiresAt').exists() || root.child('game_devices/' + auth.uid + '/expiresAt').val() === 0 || root.child('game_devices/' + auth.uid + '/expiresAt').val() > now))) || auth.token.m === 1)",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "m": {
            "$mode": {
              ".validate": "$mode.matches(/^[fah]$/)",
              "t": {
                "$tier": {
                  ".validate": "$tier.matches(/^[A-Za-z0-9_-]{1,20}$/)",
                  "$k": {
                    ".validate": "newData.isNumber() && newData.val() > -1000000000 && newData.val() < 1000000000"
                  }
                }
              },
              "$k": {
                ".validate": "newData.isNumber() && newData.val() > -1000000000 && newData.val() < 1000000000"
              }
            }
          },
          "base": {
            "$dev": {
              "t": {
                "$tier": {
                  ".validate": "$tier.matches(/^[A-Za-z0-9_-]{1,20}$/)",
                  "$k": {
                    ".validate": "newData.isNumber() && newData.val() > -1000000000 && newData.val() < 1000000000"
                  }
                }
              },
              "$k": {
                ".validate": "newData.isNumber() && newData.val() > -1000000000 && newData.val() < 1000000000"
              }
            }
          },
          "vs": {
            "$opp": {
              "$k": {
                ".validate": "newData.isNumber() && newData.val() > -1000000000 && newData.val() < 1000000000"
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "rank_days": {
      ".read": "auth != null",
      "$day": {
        ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
        "$game": {
          "$pid": {
            ".write": "auth != null && newData.exists() && ((auth.token.admin === 1 || (root.child('game_devices/' + auth.uid + '/status').val() === 'active' && (!root.child('game_devices/' + auth.uid + '/expiresAt').exists() || root.child('game_devices/' + auth.uid + '/expiresAt').val() === 0 || root.child('game_devices/' + auth.uid + '/expiresAt').val() > now))) || auth.token.m === 1)",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000"
          }
        }
      }
    },
    "game_plays": {
      ".read": true,
      "$g": {
        ".validate": "$g.matches(/^[a-z0-9]{2,20}$/)",
        "n": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || newData.val() === data.val() + 1)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "game_presence": {
      ".read": "auth != null && (auth.token.admin === 1)",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 16 && newData.child('game').isString() && newData.child('game').val().length <= 20 && newData.child('t').isNumber())",
        "name": {
          ".validate": true
        },
        "game": {
          ".validate": true
        },
        "t": {
          ".validate": true
        },
        "mode": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "ua": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "game_reports": {
      ".read": "auth != null && (auth.token.admin === 1 || (query.orderByChild === 'uid' && query.equalTo === auth.uid))",
      ".indexOn": ["uid"],
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.exists()) || auth.token.admin === 1)",
        ".validate": "newData.hasChildren(['kind','game','msg','t']) && newData.child('t').val() === now",
        "kind": {
          ".validate": "newData.val().matches(/^(error|report)$/)"
        },
        "game": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "msg": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "src": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "ua": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "url": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "n": {
          ".validate": "newData.isNumber()"
        },
        "t": {
          ".validate": true
        },
        "seen": {
          ".validate": "newData.isBoolean() && auth.token.admin === 1"
        },
        "status": {
          ".validate": "auth.token.admin === 1 && newData.isString() && newData.val().matches(/^(todo|wont|done)$/)"
        },
        "statusT": {
          ".validate": "auth.token.admin === 1 && newData.isNumber()"
        },
        "todoId": {
          ".validate": "auth.token.admin === 1 && (newData.isNumber() || newData.isString())"
        },
        "ai": {
          ".validate": "auth.token.admin === 1"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
